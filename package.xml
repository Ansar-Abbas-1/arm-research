<?xml version="1.0"?>
<package format="2">
  <name>arm_mission</name>
  <version>0.1.0</version>
  <description>Mission control for the grasp pipeline: a backend node (plant list from the detector, target selection, dry run, gated go, stop) and an rqt front end. The rviz front end is the MissionPanel of arm_gui; both are thin clients of the same service and state topic.</description>
  <maintainer email="riccardo.aliotta.ra@gmail.com">RiAliotta</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>arm_gui</depend>        <!-- hosts MissionCommand.srv (like PresetCommand: the rviz panel is a client, and arm_grasp already depends on arm_gui) -->
  <depend>arm_grasp</depend>      <!-- Grasp.srv and target_offset -->
  <depend>arm_perception</depend> <!-- ObjectDetectionArray -->
  <exec_depend>rqt_gui</exec_depend>
  <exec_depend>rqt_gui_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>rostest</test_depend>
  <export>
    <rqt_gui plugin="${prefix}/plugin.xml"/>
  </export>
</package>
