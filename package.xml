<?xml version="1.0"?>
<package format="2">
  <name>arm_perception</name>
  <version>0.1.0</version>
  <description>M7: detects an ArUco marker and reports its pose in base_link (TF, PoseStamped, JSON report, CLI).</description>
  <maintainer email="riccardo.aliotta.ra@gmail.com">Riccardo Aliotta</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>rospy</build_depend>
  <build_depend>roslaunch</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>arm_camera</exec_depend>
</package>
