<?xml version="1.0"?>
<package format="2">
  <name>arm_kinematics</name>
  <version>0.0.0</version>
  <description>Forward (and future inverse) kinematics for the 5-DOF arm chain, independent of arm_interface/DynamixelSDK.</description>

  <maintainer email="riccardo.aliotta.ra@gmail.com">Riccardo Aliotta</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>urdf</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>

  <test_depend>rostest</test_depend>
  <test_depend>rospy</test_depend>
  <test_depend>roslib</test_depend>
  <test_depend>arm_interface</test_depend>
</package>
