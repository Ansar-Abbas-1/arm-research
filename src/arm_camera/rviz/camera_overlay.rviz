Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /RobotModel1
      Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.1
      Class: rviz/Grid
      Enabled: true
      Name: Grid
      Plane Cell Count: 20
    - Alpha: 1
      Class: rviz/RobotModel
      Enabled: true
      Name: RobotModel
      Robot Description: robot_description
      TF Prefix: ""
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /arm_camera/markers
      Name: Board, frustum and RMS
      Queue Size: 100
    - Class: rviz/Image
      Enabled: true
      Image Topic: /calibration_overlay/image
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Overlay (green = detected, red = predicted)
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 1.4
      Focal Point:
        X: 0.25
        Y: 0
        Z: 0.1
      Name: Current View
      Pitch: 0.5
      Target Frame: base_link
      Value: Orbit (rviz)
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1500
