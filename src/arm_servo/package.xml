<?xml version="1.0"?>
<package format="2">
  <name>arm_servo</name>
  <version>0.1.0</version>
  <description>M8: position-based visual servoing of the end effector to a stand-off above an ArUco marker.</description>
  <maintainer email="riccardo.aliotta.ra@gmail.com">Riccardo Aliotta</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend>
  <depend>arm_kinematics</depend>
  <depend>arm_trajectory</depend>
  <depend>arm_perception</depend>
  <depend>urdf</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>eigen</depend>

  <test_depend>roslib</test_depend>
  <test_depend>arm_interface</test_depend>
  <test_depend>rostest</test_depend>
</package>
