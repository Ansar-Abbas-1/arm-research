<launch>
  <!-- sim + position_pitch_ik_node, config loaded from
       config/position_pitch_ik.yaml (see docs/position_pitch_ik.md):
       every PositionPitchIkOptions field is reconfigurable there, or
       overridden per-launch via the args below, or via any other
       rosparam-loading mechanism (this is a plain ROS param namespace,
       nothing special about how it's populated).

       roslaunch arm_kinematics position_pitch_ik.launch
       roslaunch arm_kinematics position_pitch_ik.launch nullspace_gain:=0.1 -->

  <arg name="config_file" default="$(find arm_kinematics)/config/position_pitch_ik.yaml"/>
  <arg name="nullspace_gain" default="0.05"/>
  <arg name="use_rviz" default="true"/>
  <!-- use_rviz:=false lets this run without a display, e.g. for automated
       checks: rviz needs one and none is available in an automated/CI
       context (confirmed the hard way in M0). -->
  <arg name="use_hardware" default="false"/>
  <!-- use_hardware:=true launches the real robot_interface driver (opens
       /dev/ttyUSB0, enables servo torque) instead of the kinematic
       simulator: same /joint_states_in-publish, /joint_states_out-
       subscribe interface either way, so nothing else in this file needs
       to change. -->

  <param name="robot_description"
         command="$(find xacro)/xacro '$(find arm_interface)/urdf/arm.urdf'" />

  <node name="robot_state_publisher" pkg="robot_state_publisher"
        type="robot_state_publisher">
    <remap from="joint_states" to="/joint_states_in" />
  </node>

  <group unless="$(arg use_hardware)">
    <node name="arm_sim_validator_node" pkg="arm_interface"
          type="arm_sim_validator_node">
      <param name="sim_mode" type="string" value="ideal"/>
      <param name="publish_rate" type="double" value="50.0"/>
      <param name="num_joints" type="int" value="6"/>
    </node>
  </group>
  <group if="$(arg use_hardware)">
    <node name="arm_interface" pkg="arm_interface" type="robot_interface" output="screen">
      <rosparam command="load" file="$(find arm_interface)/config/ArmInterface.yaml" />
    </node>
  </group>

  <node name="position_pitch_ik_node" pkg="arm_kinematics" type="position_pitch_ik_node"
        output="screen">
    <rosparam command="load" file="$(arg config_file)" />
    <param name="nullspace_gain" value="$(arg nullspace_gain)" />
  </node>

  <group if="$(arg use_rviz)">
    <node name="rviz" pkg="rviz" type="rviz"
          args="-d $(find arm_kinematics)/rviz/position_pitch_ik.rviz" />
  </group>
</launch>
