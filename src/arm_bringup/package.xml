<?xml version="1.0"?>
<package format="2">
  <name>arm_bringup</name>
  <version>0.1.0</version>
  <description>Complete-stack and partial launch files (arm, vision, detect, grasp) with their parameters, and the mission control front-end switch.</description>
  <maintainer email="riccardo.aliotta.ra@gmail.com">RiAliotta</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <exec_depend>arm_trajectory</exec_depend>
  <exec_depend>arm_interface</exec_depend>
  <exec_depend>arm_camera</exec_depend>
  <exec_depend>arm_perception</exec_depend>
  <exec_depend>arm_grasp</exec_depend>
  <exec_depend>arm_gui</exec_depend>
  <exec_depend>arm_mission</exec_depend>
  <exec_depend>rqt_image_view</exec_depend>
  <test_depend>roslaunch</test_depend>
</package>
