<?xml version="1.0"?>
<robot name="five_dof_arm">

    <!-- Base Link -->
    <link name="base_link">
        <visual>
            <geometry>
                <cylinder length="0.06" radius="0.10"/>
            </geometry>
            <material name="gray">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.06" radius="0.10"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="1.0"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
        </inertial>
    </link>

    <!-- Joint 1: Rotates around z axis -->
    <joint name="joint_1" type="revolute">
        <parent link="base_link"/>
        <child link="link_1"/>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-2.745" upper="2.745" effort="10" velocity="2"/>
    </joint>

    <!-- Link 1: Vertical cylinder -->
    <link name="link_1">
        <visual>
            <origin xyz="0 0 0.0325" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.065" radius="0.01"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.0325" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.065" radius="0.01"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
        </inertial>
    </link>

    <!-- Joint 2: Rotates around y axis, coplanar in xz -->
    <joint name="joint_2" type="revolute">
        <parent link="link_1"/>
        <child link="link_2"/>
        <origin xyz="0 0 0.065" rpy="0 -1.57 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="0" upper="3.14" effort="10" velocity="2"/>
    </joint>

    <!-- Link 2: Long vertical cylinder -->
    <link name="link_2">
        <visual>
            <origin xyz="0 0 0.17" rpy="0 0 1.5708"/>
            <geometry>
                <cylinder length="0.34" radius="0.01"/>
            </geometry>
            <material name="green">
                <color rgba="0 1 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.17" rpy="0 0 1.5708"/>
            <geometry>
                <cylinder length="0.34" radius="0.01"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.5"/>
            <origin xyz="0 0 0.17" rpy="0 0 1.5708"/>
            <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
        </inertial>
    </link>

    <!-- Joint 3: Rotates around y axis, coplanar in xz -->
    <joint name="joint_3" type="revolute">
        <parent link="link_2"/>
        <child link="link_intermediate"/>
        <origin xyz="0 0 0.34" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.220" upper="0" effort="10" velocity="2"/>
    </joint>

    <!-- Link Intermediate: Intermediate link, horizontal cylinder -->
    <link name="link_intermediate">
        <visual>
            <origin xyz="0.0145 0 0" rpy="0 1.5708 0"/>
            <geometry>
                <cylinder length="0.029" radius="0.01"/>
            </geometry>
            <material name="purple">
                <color rgba="0.5 0 0.5 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0.0145 0 0" rpy="0 1.5708 0"/>
            <geometry>
                <cylinder length="0.029" radius="0.01"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.8"/>
            <origin xyz="0.0145 0 0" rpy="0 1.5708 0"/>
            <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
        </inertial>
    </link>

    <!-- Joint Intermediate: Fixed link to mimic actual structure without weird movement and axes -->
    <joint name="joint_intermediate" type="fixed">
        <parent link="link_intermediate"/>
        <child link="link_3"/>
        <origin xyz="0.029 0 0" rpy="0 3.1412 0"/>
    </joint>

    <!-- Link 3: Long horizontal cylinder -->
    <link name="link_3">
        <visual>
            <origin xyz="0 0 0.188" rpy="0 0 1.5708"/>
            <geometry>
                <cylinder length="0.376" radius="0.01"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.188" rpy="0 0 1.5708"/>
            <geometry>
                <cylinder length="0.376" radius="0.01"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.8"/>
            <origin xyz="0 0 0.188" rpy="0 0 1.5708"/>
            <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
        </inertial>
    </link>

    <!-- Joint 4: Rotates around y axis, coplanar in xz -->
    <joint name="joint_4" type="revolute">
        <parent link="link_3"/>
        <child link="link_4"/>
        <origin xyz="0 0 0.376" rpy="0 -1.8791 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="0" upper="4.505" effort="10" velocity="2"/>
    </joint>

    <!-- Link 4: Long horizontal cylinder -->
    <link name="link_4">
        <visual>
            <origin xyz="0 0 0.168" rpy="0 0 1.5708"/>
            <geometry>
                <cylinder length="0.336" radius="0.01"/>
            </geometry>
            <material name="yellow">
                <color rgba="1 1 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.168" rpy="0 0 1.5708"/>
            <geometry>
                <cylinder length="0.336" radius="0.01"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.8"/>
            <origin xyz="0 0 0.168" rpy="0 0 0"/>
            <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
        </inertial>
    </link>

    <!-- Joint 5: Rotates around y axis, coplanar in xz -->
    <joint name="joint_5" type="revolute">
        <parent link="link_4"/>
        <child link="link_5"/>
        <origin xyz="0 0 0.336" rpy="0 1.81 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-3.62" upper="0" effort="10" velocity="2"/>
    </joint>


    <link name="link_5">
        <visual>
            <origin xyz="0 0 0.0525" rpy="0 0 1.5708"/>
            <geometry>
                <cylinder length="0.105" radius="0.01"/>
            </geometry>
            <material name="cyan">
                <color rgba="0 1 1 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.0525" rpy="0 0 1.5708"/>
            <geometry>
                <cylinder length="0.105" radius="0.01"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1"/>
            <origin xyz="0 0 0.0525" rpy="0 0 0"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>

    <joint name="joint_6" type="revolute">
        <parent link="link_5"/>
        <child link="end_effector"/>
        <origin xyz="0 0 0.105" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.29" upper="1.29" effort="10" velocity="2"/>
    </joint>

    <link name="end_effector">
        <visual>
            <origin xyz="0 0 0.0005" rpy="0 0 1.5708"/>
            <geometry>
                <cylinder length="0.001" radius="0.02"/>
            </geometry>
            <material name="grey">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.0005" rpy="0 0 1.5708"/>
            <geometry>
                <cylinder length="0.001" radius="0.02"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1"/>
            <origin xyz="0 0 0.0005" rpy="0 0 0"/>
            <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
        </inertial>
    </link>

</robot>