<launch>
  <!-- One-command entry point for interactively testing /reach_target_pose
       (see docs/trajectory_generation.md): sim + trajectory_service_node +
       trajectory_executor_node + reach_target_pose_node +
       interactive_pose_marker_node + rviz. In rviz, drag the orange-arrow
       marker to the desired end_effector pose, then right-click it and
       choose "Send to /reach_target_pose" to commit.

       trajectory_service_node's IK is position+pitch only, with a
       null-space secondary task (biasing nullspace_tip_link toward
       vertical) ON by default: every reach through this launch file
       shows it. Watch link_4's axes (rviz's RobotModel display, Show
       Axes) settle toward vertical as the arm moves, on top of whatever
       position+pitch the marker asked for. Tune it live, e.g. to see the
       bias more/less aggressively:
         roslaunch arm_trajectory interactive_reach.launch nullspace_gain:=0.15
         roslaunch arm_trajectory interactive_reach.launch nullspace_gain:=0.0  (off)

       For the typing alternative instead of dragging:
         rosrun arm_trajectory reach_pose_cli.py -->

  <arg name="use_rviz" default="true"/>
  <!-- use_rviz:=false lets this run without a display, e.g. for automated
       checks: rviz needs one and none is available in an automated/CI
       context (confirmed the hard way in M0). -->
  <arg name="use_hardware" default="false"/>
  <!-- use_hardware:=true launches the real robot_interface driver (opens
       /dev/ttyUSB0, enables servo torque) instead of the kinematic
       simulator: same /joint_states_in-publish, /joint_states_out-
       subscribe interface either way, so nothing else in this file needs
       to change. Every reach committed through the marker/CLI would then
       move the real arm. -->
  <!-- velocity_scale: uniform slow-down of every generated trajectory
       (M5 Stage 3, reduced speed on first real-hardware runs). Defaults
       to 0.1 whenever use_hardware is true, 1.0 in simulation, so
       forgetting this arg can never give full speed on the real arm.
       Override explicitly with velocity_scale:=0.25 etc. Note: inside
       $(eval), arg() returns Python-typed values (true becomes the boolean
       True), so this tests truthiness, not the string 'true'. -->
  <arg name="velocity_scale"
       default="$(eval 0.1 if arg('use_hardware') else 1.0)"/>
  <!-- Steady-state correction for reach_target_pose_node, OFF by default.
       correction_steps:=N (N > 0) makes the node re-aim up to N times after
       a reach, adding the measured end-effector error to a running
       compensation (see include/arm_trajectory/reach_correction.h).
       correction_trigger: error (m) at or below which it stops.
       correction_max_total: cap (m) on the total compensation.
       correction_gain: fraction of the remaining error added per step. -->
  <arg name="correction_steps" default="0"/>
  <arg name="correction_trigger" default="0.002"/>
  <arg name="correction_max_total" default="0.03"/>
  <arg name="correction_gain" default="1.0"/>
  <!-- correction_pitch: also compensate the pitch error (rad, rotation about
       the end effector's own Y axis) the same way; on whenever correction is
       on. correction_pitch_trigger / correction_pitch_max_total in rad. -->
  <arg name="correction_pitch" default="true"/>
  <arg name="correction_pitch_trigger" default="0.01"/>
  <arg name="correction_pitch_max_total" default="0.2"/>
  <arg name="nullspace_tip_link" default="link_4"/>
  <!-- nullspace_gain: defaults to 0 (bias off) on hardware. The bias is a
       per-sample STEP, not a rate: at a low velocity_scale the duration
       search adds samples without shrinking the bias motion per sample, so
       it never converges and trips the runaway-duration guard (reproduced
       in simulation at velocity_scale 0.1, gain 0.05; see
       docs/trajectory_generation.md Finding 7). Same truthiness note as
       velocity_scale above. -->
  <arg name="nullspace_gain" default="$(eval 0.0 if arg('use_hardware') else 0.05)"/>

  <param name="robot_description"
         command="$(find xacro)/xacro '$(find arm_interface)/urdf/arm.urdf'" />

  <node name="robot_state_publisher" pkg="robot_state_publisher"
        type="robot_state_publisher">
    <remap from="joint_states" to="/joint_states_in" />
  </node>

  <group unless="$(arg use_hardware)">
    <node name="arm_sim_validator_node" pkg="arm_interface"
          type="arm_sim_validator_node">
      <param name="sim_mode" type="string" value="ideal"/>
      <param name="publish_rate" type="double" value="50.0"/>
      <param name="num_joints" type="int" value="6"/>
    </node>
  </group>
  <group if="$(arg use_hardware)">
    <node name="arm_interface" pkg="arm_interface" type="robot_interface" output="screen">
      <rosparam command="load" file="$(find arm_interface)/config/ArmInterface.yaml" />
    </node>
  </group>

  <node name="trajectory_service_node" pkg="arm_trajectory" type="trajectory_service_node">
    <param name="nullspace_tip_link" value="$(arg nullspace_tip_link)" />
    <param name="nullspace_gain" value="$(arg nullspace_gain)" />
    <param name="velocity_scale" value="$(arg velocity_scale)" />
  </node>
  <node name="trajectory_executor_node" pkg="arm_trajectory" type="trajectory_executor_node" />
  <node name="reach_target_pose_node" pkg="arm_trajectory" type="reach_target_pose_node">
    <param name="correction_steps" value="$(arg correction_steps)" />
    <param name="correction_trigger" value="$(arg correction_trigger)" />
    <param name="correction_max_total" value="$(arg correction_max_total)" />
    <param name="correction_gain" value="$(arg correction_gain)" />
    <param name="correction_pitch" value="$(arg correction_pitch)" />
    <param name="correction_pitch_trigger" value="$(arg correction_pitch_trigger)" />
    <param name="correction_pitch_max_total" value="$(arg correction_pitch_max_total)" />
  </node>
  <node name="interactive_pose_marker_node" pkg="arm_trajectory" type="interactive_pose_marker_node" />

  <group if="$(arg use_rviz)">
    <node name="rviz" pkg="rviz" type="rviz"
          args="-d $(find arm_trajectory)/rviz/interactive_reach.rviz" />
  </group>
</launch>
