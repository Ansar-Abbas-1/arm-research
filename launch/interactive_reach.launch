<launch>
  <!-- One-command entry point for interactively testing /reach_target_pose
       (see docs/trajectory_generation.md): sim + trajectory_service_node +
       trajectory_executor_node + reach_target_pose_node +
       interactive_pose_marker_node + rviz. In rviz, drag the orange-arrow
       marker to the desired end_effector pose, then right-click it and
       choose "Send to /reach_target_pose" to commit.

       trajectory_service_node's IK is position+pitch only, with a
       null-space secondary task (biasing nullspace_tip_link toward
       vertical) ON by default: every reach through this launch file
       shows it. Watch link_4's axes (rviz's RobotModel display, Show
       Axes) settle toward vertical as the arm moves, on top of whatever
       position+pitch the marker asked for. Tune it live, e.g. to see the
       bias more/less aggressively:
         roslaunch arm_trajectory interactive_reach.launch nullspace_gain:=0.15
         roslaunch arm_trajectory interactive_reach.launch nullspace_gain:=0.0  (off)

       For the typing alternative instead of dragging:
         rosrun arm_trajectory reach_pose_cli.py -->

  <arg name="use_rviz" default="true"/>
  <!-- use_rviz:=false lets this run without a display, e.g. for automated
       checks: rviz needs one and none is available in an automated/CI
       context (confirmed the hard way in M0). -->
  <arg name="use_hardware" default="false"/>
  <!-- use_hardware:=true launches the real robot_interface driver (opens
       /dev/ttyUSB0, enables servo torque) instead of the kinematic
       simulator: same /joint_states_in-publish, /joint_states_out-
       subscribe interface either way, so nothing else in this file needs
       to change. Every reach committed through the marker/CLI would then
       move the real arm. -->
  <!-- velocity_scale: uniform scale on the URDF joint velocity limits (2 rad/s)
       used to time every generated trajectory. Default 1.0, hardware included
       (operator decision 2026-10-05). It was 0.1 on hardware during
       commissioning: pass velocity_scale:=0.1 for that, which the e-stop
       checks in arm_interface/docs/sim_to_real.md section 16 were verified at
       (their fixed 2.5 s trigger delay assumes the 6 s plan at 0.1). Keep
       robot_interface max_goal_slew_rad_s at or above the planned peak speed,
       and max_joint_acceleration limits small moves independently. -->
  <arg name="velocity_scale" default="1.0"/>
  <!-- Steady-state correction for reach_target_pose_node, OFF by default.
       correction_steps:=N (N > 0) makes the node re-aim up to N times after
       a reach, adding the measured end-effector error to a running
       compensation (see include/arm_trajectory/reach_correction.h).
       correction_trigger: error (m) at or below which it stops.
       correction_max_total: cap (m) on the total compensation.
       correction_gain: fraction of the remaining error added per step. -->
  <arg name="correction_steps" default="0"/>
  <arg name="correction_trigger" default="0.006"/>
  <arg name="correction_max_total" default="0.06"/>
  <arg name="correction_gain" default="1.0"/>
  <!-- correction_pitch: also compensate the pitch error (rad, rotation about
       the end effector's own Y axis) the same way; on whenever correction is
       on. correction_pitch_trigger / correction_pitch_max_total in rad. -->
  <arg name="correction_pitch" default="true"/>
  <arg name="correction_pitch_trigger" default="0.01"/>
  <arg name="correction_pitch_max_total" default="0.2"/>
  <arg name="nullspace_tip_link" default="link_4"/>
  <!-- nullspace_gain: ON by default (0.05) everywhere, hardware included. It
       keeps nullspace_tip_link near vertical, which lowers the gravity
       torque on motor 4 (it overloaded and dropped power when held for long
       in a high-torque posture). The bias is a per-iteration step, so along
       a Cartesian path it is rate-capped to nullspace_rate_fraction of the
       slowest (scaled) joint velocity limit; without the cap it broke the
       duration search at low velocity_scale (docs/trajectory_generation.md
       Finding 7). nullspace_rate_fraction:=0 removes the cap. -->
  <arg name="nullspace_gain" default="0.05"/>
  <arg name="nullspace_rate_fraction" default="0.25"/>
  <!-- max_joint_velocity: absolute per-joint speed cap in rad/s, applied as
       min(URDF limit, cap) before velocity_scale. 0 = unset (URDF limits).
       A per-joint list can be set with rosparam instead. Keep it below
       robot_interface max_goal_slew_rad_s (2.0) or the goal will lag. -->
  <arg name="max_joint_velocity" default="0.0"/>
  <!-- max_joint_acceleration: absolute per-joint acceleration cap in rad/s^2
       (scalar here, or a per-joint list through rosparam); 0 = no bound.
       A quintic move peaks at 5.77 * delta / T^2, so this lengthens SMALL
       moves (a 1 cm correction at 0.2 rad/s would otherwise take about
       0.09 s and peak near 6 rad/s^2). Defaults to 1.0 on hardware, which
       is a heuristic starting value, not derived from the motor spec, and
       to unbounded in simulation. Truthiness note as for velocity_scale. -->
  <arg name="max_joint_acceleration" default="$(eval 1.0 if arg('use_hardware') else 0.0)"/>
  <!-- max_goal_slew_rad_s: robot_interface goal slew limit (0 = yaml value,
       2.0 rad/s per joint). Passed to the real driver only. -->
  <arg name="max_goal_slew_rad_s" default="0.0"/>

  <!-- Simulator only: inject a bad motor to try the Arm Control panel's motor report and "Reset failed motors"
       without touching the real arm. N is the 1-based joint (0 = none): sim_motor_warn_joint shows 47 C near the
       limit, sim_motor_fault_joint an overload that "Reset failed motors" (or the reenable service) clears. -->
  <arg name="sim_motor_warn_joint" default="0"/>
  <arg name="sim_motor_fault_joint" default="0"/>

  <param name="robot_description"
         command="$(find xacro)/xacro '$(find arm_interface)/urdf/arm.urdf'" />

  <node name="robot_state_publisher" pkg="robot_state_publisher"
        type="robot_state_publisher">
    <remap from="joint_states" to="/joint_states_in" />
  </node>

  <group unless="$(arg use_hardware)">
    <node name="arm_sim_validator_node" pkg="arm_interface"
          type="arm_sim_validator_node">
      <param name="sim_mode" type="string" value="ideal"/>
      <param name="publish_rate" type="double" value="50.0"/>
      <param name="num_joints" type="int" value="6"/>
      <param name="sim_motor_warn_joint" type="int" value="$(arg sim_motor_warn_joint)"/>
      <param name="sim_motor_fault_joint" type="int" value="$(arg sim_motor_fault_joint)"/>
    </node>
  </group>
  <group if="$(arg use_hardware)">
    <node name="arm_interface" pkg="arm_interface" type="robot_interface" output="screen">
      <rosparam command="load" file="$(find arm_interface)/config/ArmInterface.yaml" />
      <rosparam if="$(eval arg('max_goal_slew_rad_s') > 0)" param="max_goal_slew_rad_s" subst_value="true">[$(arg max_goal_slew_rad_s), $(arg max_goal_slew_rad_s), $(arg max_goal_slew_rad_s), $(arg max_goal_slew_rad_s), $(arg max_goal_slew_rad_s), $(arg max_goal_slew_rad_s)]</rosparam>
    </node>
  </group>

  <node name="trajectory_service_node" pkg="arm_trajectory" type="trajectory_service_node">
    <param name="nullspace_tip_link" value="$(arg nullspace_tip_link)" />
    <param name="nullspace_gain" value="$(arg nullspace_gain)" />
    <param name="velocity_scale" value="$(arg velocity_scale)" />
    <param name="nullspace_rate_fraction" value="$(arg nullspace_rate_fraction)" />
    <param name="max_joint_velocity" value="$(arg max_joint_velocity)" />
    <param name="max_joint_acceleration" value="$(arg max_joint_acceleration)" />
  </node>
  <node name="trajectory_executor_node" pkg="arm_trajectory" type="trajectory_executor_node" />
  <node name="reach_target_pose_node" pkg="arm_trajectory" type="reach_target_pose_node">
    <param name="correction_steps" value="$(arg correction_steps)" />
    <param name="correction_trigger" value="$(arg correction_trigger)" />
    <param name="correction_max_total" value="$(arg correction_max_total)" />
    <param name="correction_gain" value="$(arg correction_gain)" />
    <param name="correction_pitch" value="$(arg correction_pitch)" />
    <param name="correction_pitch_trigger" value="$(arg correction_pitch_trigger)" />
    <param name="correction_pitch_max_total" value="$(arg correction_pitch_max_total)" />
  </node>
  <node name="interactive_pose_marker_node" pkg="arm_trajectory" type="interactive_pose_marker_node" />

  <!-- Preset-pose backend for the "Arm Control" rviz panel (arm_gui): it holds the poses (config/presets.yaml,
       plus the ones you save from the panel in ~/.ros/arm_trajectory/presets.yaml) and runs the moves through the
       same planner and executor as every other reach. presets:=false leaves it out (the panel then has no
       preset buttons; its e-stop, torque and motor controls still work). preset_max_delta limits the largest
       joint move a preset may start (rad; a heuristic guard against a typo in a saved pose, 0 = no limit). -->
  <arg name="presets" default="true"/>
  <arg name="preset_max_delta" default="0"/>
  <group if="$(arg presets)">
    <node name="preset_manager" pkg="arm_trajectory" type="preset_manager_node.py" output="screen">
      <rosparam command="load" file="$(find arm_trajectory)/config/presets.yaml"/>
      <param name="max_delta" value="$(arg preset_max_delta)"/>
    </node>
  </group>

  <group if="$(arg use_rviz)">
    <node name="rviz" pkg="rviz" type="rviz"
          args="-d $(find arm_trajectory)/rviz/interactive_reach.rviz" />
  </group>
</launch>
