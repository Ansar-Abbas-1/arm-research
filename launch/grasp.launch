<launch>
  <!-- TF-driven grasp sequence. Needs the arm stack (arm_trajectory/interactive_reach.launch: planner, executor, driver or
       simulator) AND the gripper_control node (roslaunch arm_grasp gripper_control.launch, or gripper_monitor.launch, which
       also records): the gripper belongs to that node and a real grasp is refused without it. Start it only once, never twice. The target is any TF frame in base_link whose +z is the surface normal, for example marker_118 from
       marker_localizer. Nothing moves until you call the service. First PLAN ONLY (nothing moves):
         rosservice call /grasp_sequencer/grasp "target_frame: 'marker_118'
         dry_run: true"
       then, with the e-stop in reach and the arm supported, the same with dry_run: false; follow it with
         rostopic echo /grasp_sequencer/status        (rosservice call /grasp_sequencer/stop ends it; the driver holds)
       After a successful lift of a real grasp the arm returns to the viewing pose, the preset named by view_preset in config/grasp.yaml (state RETURNING; the plant
       stays in the gripper; "" turns it off; an unknown preset refuses the grasp; needs preset_manager from arm_trajectory presets:=true).
       Every default in config/grasp.yaml is flagged: confirm the gripper geometry before a real grasp. -->
  <!-- respawn: restart a node that dies, after respawn_delay seconds (default off here; the arm_bringup launch files turn it on). rviz is never respawned: closing it is deliberate.
       The hardware DRIVER has its own switch, respawn_driver (default off): a driver that crashes on a motor error would otherwise re-enable the torque again and again. -->
  <arg name="respawn" default="false"/>
  <arg name="respawn_delay" default="2.0"/>
  <arg name="config" default="$(find arm_grasp)/config/grasp.yaml"/>
  <!-- sag_log_dir: where the sequencer logs its raw end-effector measurements (sag_*.jsonl, the input of scripts/sag_fit.py); empty = the yaml value (the real arm's
       recordings/sag). Simulated runs (the e2e test, bringups with use_hardware:=false) must log elsewhere, or their zero-sag rows corrupt a refit. -->
  <arg name="sag_log_dir" default=""/>
  <!-- sag_gain: scale of the sag model's feed-forward; empty = the yaml value (1.0), 0 = model off (raw sag, e.g. for the motor gain sweep). -->
  <arg name="sag_gain" default=""/>
  <node respawn="$(arg respawn)" respawn_delay="$(arg respawn_delay)" name="grasp_sequencer" pkg="arm_grasp" type="grasp_sequencer_node.py" output="screen">
    <rosparam command="load" file="$(arg config)"/>
    <param name="sag_log_dir" value="$(arg sag_log_dir)" unless="$(eval arg('sag_log_dir') == '')"/>
    <param name="sag_gain" value="$(arg sag_gain)" type="double" unless="$(eval arg('sag_gain') == '')"/>
  </node>
</launch>
