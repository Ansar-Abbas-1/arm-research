<launch>
  <!-- Eye-in-hand USB camera through usb_cam. Parameters: config/camera.yaml.
       The intrinsic calibration is read from config/camera_info.yaml; until it exists the
       driver publishes an all-zero camera_info and the calibration nodes say so.
       device: video node of the camera (the Microdia Vitade AF is /dev/video2 on this
       machine; check with: for d in /sys/class/video4linux/video*; do echo $d; cat $d/name; done). -->
  <arg name="device" default="/dev/video2"/>
  <arg name="camera_info_url" default="file://$(find arm_camera)/config/camera_info.yaml"/>

  <node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen">
    <rosparam command="load" file="$(find arm_camera)/config/camera.yaml"/>
    <param name="video_device" value="$(arg device)"/>
    <param name="camera_info_url" value="$(arg camera_info_url)"/>
  </node>
</launch>
