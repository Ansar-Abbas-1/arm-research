<launch>
  <!-- The grasp target as a marker plus a hand-measured offset (see scripts/grasp_target_node.py). Needs the camera stack and
       marker_localizer (marker_<id> is published only while the camera is still and sees the marker). The offset is in the MARKER frame
       (+z out of the surface, x and y in its plane), in metres. Then plan with:
         rosservice call /grasp_sequencer/grasp "{target_frame: grasp_target, dry_run: true}"
       The sequencer refuses a target older than target_max_age (5 s), so keep the marker in view and the arm still when you call it. -->
  <arg name="marker" doc="TF frame of the marker, for example marker_984"/>
  <arg name="offset_x" default="0.0"/>
  <arg name="offset_y" default="0.0"/>
  <arg name="offset_z" default="0.0"/>
  <arg name="target_frame" default="grasp_target"/>
  <!-- vertical:=true makes the target frame exactly upright (the marker's heading kept) for a marker lying on a level floor: the approach is then
       straight down and the marker pose's tilt noise (a few degrees) cannot make the plan refuse the target. -->
  <arg name="vertical" default="false"/>
  <!-- approach: down (the gripper comes from above, default), forward (a SIDE grasp: the tool looks horizontally outward) or an angle in
       degrees below the horizontal such as 45 (the tool looks outward and down; 90 = down, 0 = forward); the gripper closes sideways on the target. It is a parameter read every cycle, so it can be flipped while running: rosparam set /grasp_target/approach 45.
       The sequencer plans a side approach by itself when the frame is horizontal (config/grasp.yaml side_grasp_height, side_lift). -->
  <arg name="approach" default="down"/>
  <node name="grasp_target" pkg="arm_grasp" type="grasp_target_node.py" output="screen">
    <param name="marker_frame" value="$(arg marker)"/>
    <rosparam param="offset" subst_value="true">[$(arg offset_x), $(arg offset_y), $(arg offset_z)]</rosparam>
    <param name="target_frame" value="$(arg target_frame)"/>
    <param name="vertical" value="$(arg vertical)"/>
    <param name="approach" value="$(arg approach)"/>
  </node>
</launch>
