<launch>
    <!-- use_hardware:=false swaps the real robot_interface driver (opens
         /dev/ttyUSB0, enables servo torque) for arm_sim_validator_node:
         same /joint_states_in-publish, /joint_states_out-subscribe
         interface either way. Defaults to true so this file's existing
         behavior (this is the hardware entry point) is unchanged unless
         asked otherwise. -->
    <arg name="use_hardware" default="true"/>

    <!-- Launch the robot_state_publisher with the URDF file -->
    <param name="robot_description" command="$(find xacro)/xacro '$(find arm_interface)/urdf/arm.urdf'" />

    <!-- Remap joint_states topic for robot_state_publisher -->
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" output="screen">
        <remap from="joint_states" to="/joint_states_in" />
    </node>

    <!-- Activate the robot interface -->
    <group if="$(arg use_hardware)">
        <node name="arm_interface" pkg="arm_interface" type="robot_interface" output="screen">
            <rosparam command="load" file="$(find arm_interface)/config/ArmInterface.yaml" />
        </node>
    </group>
    <group unless="$(arg use_hardware)">
        <node name="arm_sim_validator_node" pkg="arm_interface" type="arm_sim_validator_node" output="screen">
            <param name="sim_mode" type="string" value="ideal"/>
            <param name="publish_rate" type="double" value="50.0"/>
            <param name="num_joints" type="int" value="6"/>
        </node>
    </group>

    <!-- RViz to visualize the robot -->
    <node name="rviz" pkg="rviz" type="rviz" output="screen" args="-d $(find arm_interface)/rviz/arm.rviz" />
</launch>